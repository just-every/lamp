{
  "name": "lamp",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Cron runs every minute; scheduled publication and maintenance transitions are bounded at 240 seconds (CONTRACT UPDATE-006, MAINT-002).
  "triggers": { "crons": ["* * * * *"] },
  "assets": {
    "binding": "ASSETS",
    // Host isolation applies to every request, including misses and generated assets.
    "run_worker_first": true
  },
  "vars": {
    // Each surface has its own hostname, and each host has its own home page: the
    // app host's `/` is the Lamp landing page beside sign-in and the operator app,
    // and the page host's `/` is the public status page. Locally both are loopback
    // names on the same port. Equal hostnames fail at startup.
    "LAMP_PAGE_HOST": "localhost",
    "LAMP_APP_HOST": "127.0.0.1",
    // Local sample identity; without a provider key, mail requests fail explicitly.
    // Deployment setup supplies the buyer's verified sender.
    "MAIL_FROM_ADDRESS": "lamp@localhost.invalid",
    "MAIL_PROVIDER": "",
    "MAIL_FROM": "",
    "MAIL_RELAY_URL": ""
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "lamp-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations/core" }
  ],
  "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "lamp-local-snapshots" }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "lamp-local-jobs" }],
    "consumers": [{ "queue": "lamp-local-jobs", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 5 }]
  },
  "durable_objects": { "bindings": [{ "name": "SNAPSHOT_CACHE", "class_name": "SnapshotCache" }] },
  "migrations": [{ "tag": "snapshot-cache-v1", "new_sqlite_classes": ["SnapshotCache"] }]
}
