"dependencies":["alert_sources","incidents"],"name":"alert_receipts","rowidAlias":null,"sql":"CREATE TABLE alert_receipts (\n  id TEXT PRIMARY KEY NOT NULL,\n  source_id TEXT NOT NULL REFERENCES alert_sources(id) ON DELETE CASCADE,\n  request_hash TEXT NOT NULL,\n  deduplication_key TEXT,\n  incident_id TEXT REFERENCES incidents(id) ON DELETE SET NULL,\n  state TEXT NOT NULL CHECK (state IN ('firing', 'recovered', 'invalid')),\n  received_at TEXT NOT NULL,\n  recovered_at TEXT,\n  payload_json TEXT NOT NULL,\n  error TEXT,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL,\n  UNIQUE(source_id, request_hash)\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"name","notnull":1,"pk":0,"type":"TEXT"},{"name":"credential_kind","notnull":1,"pk":0,"type":"TEXT"},{"name":"signing_secret","notnull":0,"pk":0,"type":"TEXT"},{"name":"bearer_token_hash","notnull":0,"pk":0,"type":"TEXT"},{"name":"timestamp_header","notnull":1,"pk":0,"type":"TEXT"},{"name":"signature_header","notnull":1,"pk":0,"type":"TEXT"},{"name":"deduplication_path","notnull":1,"pk":0,"type":"TEXT"},{"name":"title_path","notnull":1,"pk":0,"type":"TEXT"},{"name":"state_path","notnull":1,"pk":0,"type":"TEXT"},{"name":"recovered_value","notnull":1,"pk":0,"type":"TEXT"},{"name":"created_by_operator_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"preset","notnull":0,"pk":0,"type":"TEXT"},{"name":"component_id","notnull":0,"pk":0,"type":"TEXT"}],"count":0,"dependencies":["components","operators"],"name":"alert_sources","rowidAlias":null,"sql":"CREATE TABLE alert_sources (\n  id TEXT PRIMARY KEY NOT NULL,\n  name TEXT NOT NULL UNIQUE,\n  credential_kind TEXT NOT NULL CHECK (credential_kind IN ('hmac-sha256', 'bearer-token')),\n  signing_secret TEXT,\n  bearer_token_hash TEXT,\n  timestamp_header TEXT NOT NULL DEFAULT 'x-lamp-timestamp',\n  signature_header TEXT NOT NULL DEFAULT 'x-lamp-signature',\n  deduplication_path TEXT NOT NULL,\n  title_path TEXT NOT NULL,\n  state_path TEXT NOT NULL,\n  recovered_value TEXT NOT NULL DEFAULT 'recovered',\n  created_by_operator_id TEXT NOT NULL REFERENCES operators(id) ON DELETE RESTRICT,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL, preset TEXT CHECK (preset IS NULL OR preset IN ('datadog', 'uptimerobot', 'betterstack', 'pingdom')), component_id TEXT REFERENCES components(id) ON DELETE SET NULL,\n  CHECK ((credential_kind = 'hmac-sha256' AND signing_secret IS NOT NULL AND bearer_token_hash IS NULL)\n      OR (credential_kind = 'bearer-token' AND bearer_token_hash IS NOT NULL AND signing_secret IS NULL))\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"entity_type","notnull":1,"pk":0,"type":"TEXT"},{"name":"entity_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"action","notnull":1,"pk":0,"type":"TEXT"},{"name":"operator_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"reason","notnull":0,"pk":0,"type":"TEXT"},{"name":"payload_json","notnull":1,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":1,"dependencies":["operators"],"name":"audit_entries","rowidAlias":null,"sql":"CREATE TABLE audit_entries (\n  id TEXT PRIMARY KEY NOT NULL,\n  entity_type TEXT NOT NULL,\n  entity_id TEXT NOT NULL,\n  action TEXT NOT NULL,\n  operator_id TEXT REFERENCES operators(id) ON DELETE SET NULL,\n  reason TEXT,\n  payload_json TEXT NOT NULL DEFAULT '{}',\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL\n)"},{"columns":[{"name":"destination_id","notnull":1,"pk":1,"type":"TEXT"},{"name":"component_id","notnull":1,"pk":2,"type":"TEXT"}],"count":0,"dependencies":["channel_destinations","components"],"name":"channel_destination_components","rowidAlias":null,"sql":"CREATE TABLE channel_destination_components (\n  destination_id TEXT NOT NULL REFERENCES channel_destinations(id) ON DELETE CASCADE,\n  component_id TEXT NOT NULL REFERENCES components(id) ON DELETE CASCADE,\n  PRIMARY KEY (destination_id, component_id)\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"kind","notnull":1,"pk":0,"type":"TEXT"},{"name":"name","notnull":1,"pk":0,"type":"TEXT"},{"name":"sealed_url","notnull":1,"pk":0,"type":"TEXT"},{"name":"host","notnull":1,"pk":0,"type":"TEXT"},{"name":"selection_mode","notnull":1,"pk":0,"type":"TEXT"},{"name":"created_by_operator_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"removed_at","notnull":0,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":0,"dependencies":["operators"],"name":"channel_destinations","rowidAlias":null,"sql":"CREATE TABLE channel_destinations (\n  id TEXT PRIMARY KEY NOT NULL,\n  kind TEXT NOT NULL CHECK (kind IN ('slack', 'teams')),\n  name TEXT NOT NULL,\n  sealed_url TEXT NOT NULL,\n  host TEXT NOT NULL,\n  selection_mode TEXT NOT NULL DEFAULT 'all' CHECK (selection_mode IN ('all', 'selected')),\n  created_by_operator_id TEXT NOT NULL REFERENCES operators(id) ON DELETE RESTRICT,\n  removed_at TEXT,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"incident_update_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"destination_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"queued_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"incident_impact","notnull":0,"pk":0,"type":"TEXT"}],"count":0,"dependencies":["channel_destinations","incident_updates"],"name":"channel_posts","rowidAlias":null,"sql":"CREATE TABLE channel_posts (\n  id TEXT PRIMARY KEY NOT NULL,\n  incident_update_id TEXT NOT NULL REFERENCES incident_updates(id) ON DELETE CASCADE,\n  destination_id TEXT NOT NULL REFERENCES channel_destinations(id) ON DELETE CASCADE,\n  queued_at TEXT NOT NULL, incident_impact TEXT CHECK (incident_impact IN ('none', 'minor', 'major', 'critical')),\n  U