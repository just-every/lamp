{
  "$comment": "rer verify serves the production build at one https origin (rer-hosted-check.invalid) the way rer deploy hosts it, with stand-ins for these secrets. Lamp answers built files and /health on its app host, so the check runs as that host; optional provider keys stay unset as on a fresh deploy. Lamp's own deploy reads OPERATIONS.md, not this file.",
  "project": "just-every/lamp",
  "vars": {
    "LAMP_APP_HOST": "rer-hosted-check.invalid",
    "LAMP_PAGE_HOST": "status.rer-hosted-check.invalid",
    "SETUP_OPERATOR_EMAIL": "owner@rer-hosted-check.invalid"
  },
  "secrets": [
    {
      "binding": "SETUP_TOKEN",
      "environment": "SETUP_TOKEN"
    },
    {
      "binding": "SESSION_SECRET",
      "environment": "SESSION_SECRET"
    },
    {
      "binding": "SUBSCRIBER_TOKEN_SECRET",
      "environment": "SUBSCRIBER_TOKEN_SECRET"
    },
    {
      "binding": "WEBHOOK_SIGNING_SECRET",
      "environment": "WEBHOOK_SIGNING_SECRET"
    },
    {
      "binding": "MAIL_PROVIDER",
      "environment": "MAIL_PROVIDER",
      "verifyStandIn": "sendgrid"
    },
    {
      "binding": "MAIL_FROM",
      "environment": "MAIL_FROM_ADDRESS",
      "verifyStandIn": "proof@rer-hosted-check.invalid"
    },
    {
      "binding": "MAIL_API_KEY",
      "environment": "MAIL_PROVIDER_API_KEY"
    }
  ]
}
