+  const manifest = createRequire(join(project.root, 'package.json')).resolve('wrangler/package.json');
+  const { bin } = JSON.parse(await readFile(manifest, 'utf8'));
+  const executable = typeof bin === 'string' ? bin : bin?.wrangler;
+  if (typeof executable !== 'string' || !executable.trim()) throw invalid('The installed Wrangler package does not declare its executable.');
+  const wrangler = resolve(dirname(manifest), executable);
+  await store.run('Deploying the demo Worker and its container image', process.execPath, [wrangler, 'deploy', '--config', 'wrangler.json', '--secrets-file', '.secrets.json'], { cwd: folder, signal });
+ } finally { await rm(secrets, { force: true }); }
+ return { dryRun: false, deployed: true, origin: plan.origin, demo: summary };
+}
