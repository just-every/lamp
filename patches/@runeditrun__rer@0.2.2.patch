new file mode 100644
index 0000000000000000000000000000000000000000..dc137034dac5ae1e12fcfb1fe3ec56a8fae0bb71
--- /dev/null
+++ b/modules/demo-host/plan.mjs
@@ -0,0 +1,58 @@
+import { createHash } from 'node:crypto';
+import { assert, resourceName } from '../deploy-kit/validation.mjs';
+import { ownerWorkerName } from '../deploy-kit/owner.mjs';
+import { siteDeclaration } from '../deploy-kit/site.mjs';
+
+/* A seed's hosted demo at demo.<domain>: the Worker `rer deploy --demo` builds
+ * from deploy-demo.json, as `rer deploy --site` builds the run site from
+ * deploy-site.json. It is this folder's front Worker plus a Container class
+ * running the seed's own image (`rer build --platform container`, workerd
+ * engine), deployed by `wrangler deploy` with the image beside it. */
+
+export const DEMO_FILES = ['worker.mjs', 'container.mjs', 'capacity.mjs', 'claim.mjs', 'pages.mjs'];
+const FRONT_SET = /^(?:RER_.*|SESSION_SECRET|SETUP_TOKEN|OWNER_EMAIL)$/;
+const SECRET = /SECRET|TOKEN|PASSWORD|_KEY$/;
+
+/**
+ * deploy-demo.json: `{ "version": 1, "domain": "run-lamp.com", "name": "Lamp" }`, plus optionally
+ * `maxInstances` (concurrent demos, default 10) and `settings`, the seed's plain demo settings
+ * (such as MAIL_PROVIDER: "development"). Settings never carry secrets or what the front sets.
+ */
+export function demoDeclaration(value, originVar) {
+  assert(value && typeof value === 'object' && !Array.isArray(value) && value.version === 1 && Object.keys(value).every(key => ['version', 'domain', 'name', 'maxInstances', 'settings'].includes(key)), 'invalid-demo-declaration');
+  siteDeclaration({ version: 1, domain: value.domain });
+  assert(typeof value.name === 'string' && value.name.trim() === value.name && value.name.length > 0 && value.name.length <= 60 && !/[\p{Cc}\p{Cf}]/u.test(value.name), 'invalid-demo-name');
+  const maxInstances = value.maxInstances ?? 10;
+  assert(Number.isSafeInteger(maxInstances) && maxInstances >= 1 && maxInstances <= 100, 'invalid-demo-max-instances');
+  const settings = value.settings ?? {};
+  assert(settings && typeof settings === 'object' && !Array.isArray(settings) && Object.entries(settings).every(([name, setting]) =>
+    /^[A-Z][A-Z0-9_]{0,63}$/.test(name) && !FRONT_SET.test(name) && !SECRET.test(name) && name !== originVar && typeof setting === 'string' && setting.length <= 1024), 'invalid-demo-settings');
+  return { domain: value.domain, name: value.name, maxInstances, settings };
+}
+
+// Container application names reject the Worker's consecutive dashes. Hash the
+// complete identity instead of normalizing dashes, which could merge names.
+export function demoContainerName(worker) {
+  return `demo-${createHash('sha256').update(worker).digest('hex').slice(0, 32)}`;
+}
+
+/** The demo Worker's name and its Wrangler configuration; no provider request. */
+export function demoPlan({ project, environment, compatibilityDate, originVar, declaration, turnstileSiteKey }) {
+  assert(/^\d{4}-\d{2}-\d{2}$/.test(compatibilityDate ?? '') && /^[A-Z][A-Z0-9_]{0,63}$/.test(originVar ?? ''), 'invalid-plan');
+  const { domain, name, maxInstances, settings } = demoDeclaration(declaration, originVar);
+  const worker = `${ownerWorkerName(project, environment)}--demo`, hostname = `demo.${domain}`;
+  assert(resourceName(worker), 'owner-name-too-long');
+  // Rate limit namespaces are account-wide integers: one per demo Worker.
+  const namespace = String(1000 + parseInt(createHash('sha256').update(worker).digest('hex').slice(0, 8), 16) % 1_000_000_000);
+  const wrangler = {
+    name: worker, main: 'worker.mjs', compatibility_date: compatibilityDate, workers_dev: false, preview_urls: false,
+    routes: [{ pattern: hostname, custom_domain: true }],
+    vars: { DEMO_ORIGIN: `https://${hostname}`, DEMO_SITE: `https://${domain}`, DEMO_NAME: name, DEMO_ORIGIN_VAR: originVar, DEMO_MAX_INSTANCES: String(maxInstances), DEMO_SETTINGS: JSON.stringify(settings),
+      ...(turnstileSiteKey ? { TURNSTILE_SITE_KEY: turnstileSiteKey } : {}) },
+    durable_objects: { bindings: [{ name: 'DEMO', class_name: 'DemoContainer' }, { name: 'CAPACITY', class_name: 'DemoCapacity' }] },
+    migrations: [{ tag: 'v1', new_sqlite_classes: ['DemoContainer', 'DemoCapacity'] }],
+    containers: [{ name: demoContainerName(worker), class_name: 'DemoContainer', image: './image/Dockerfile', max_instances: maxInstances, instance_type: 'basic' }],
+    ratelimits: [{ name: 'STARTS', namespace_id: namespace, simple: { limit: 3, period: 60 } }],
+  };
+  return { worker, hostname, origin: `https://${hostname}`, maxInstances, settings: Object.keys(settings), wrangler };
+}
diff --git a/modules/demo-host/worker.mjs b/modules/demo-host/worker.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..3ccbf7c6be5755cf3aa93a5cc44ab0049cf29eda
--- /dev/null
+++ b/modules/demo-host/worker.mjs
@@ -0,0 +1,72 @@
+// A seed's hosted demo at demo.<domain>, generated by `rer deploy --demo`.
+// GET / shows the start page (a Turnstile managed widget that submits itself).
+// POST /__demo/start checks the visitor's IP rate limit, Turnstile and capacity,
+// then starts a container of their own, signs its owner in and sets the
+// rer_demo cookie. Every request with that cookie goes to the visitor's
+// container; nothing else on this host is reachable.
+import { startPage, demoCookie } from './pages.mjs';
+
+export { DemoContainer } from './container.mjs';
+export { DemoCapacity } from './capacity.mjs';
+
+const HOUR = 60 * 60_000;
+const home = () => new Response(null, { status: 303, headers: { location: '/' } });
+
+/** The visitor's demo from its cookie; ids are checked by idFromString, so a forged one is no demo. */
+function demoId(request, env) {
+  const value = (request.headers.get('cookie') ?? '').split(';').map(part => part.trim()).find(part => part.startsWith('rer_demo='))?.slice(9);
+  if (!value) return null;
+  try { return env.DEMO.idFromString(value); } catch { return null; }
+}
+
+// The demo's end in the visitor's time zone, as the Demo bar shows it (HH:MM).
+function localTime(time, timeZone = 'UTC') {
+  const parts = Object.fromEntries(new Intl.DateTimeFormat('en-US', { timeZone, hourCycle: 'h23', year: 'numeric', month: '2-digit', day: '2-digit',
+    hour: '2-digit', minute: '2-digit', second: '2-digit', timeZoneName: 'longOffset' }).formatToParts(time).map(part => [part.type, part.value]));
+  return `${parts.year}-${parts.month}-${parts.day}T${parts.hour}:${parts.minute}:${parts.second}${parts.timeZoneName === 'GMT' ? '+00:00' : parts.timeZoneName.slice(3)}`;
+}
+
+async function human(env, token, ip) {
+  if (typeof token !== 'string' || !token || token.length > 2048) return false;
+  const body = new URLSearchParams({ secret: env.TURNSTILE_SECRET_KEY, response: token });
+  if (ip) body.set('remoteip', ip);
+  const response = await fetch('https://challenges.cloudflare.com/turnstile/v0/siteverify', { method: 'POST', body });
+  const result = response.ok ? await response.json() : {};
+  if (result.success !== true) console.error('Turnstile refused a start:', response.status, JSON.stringify(result['error-codes'] ?? []));
+  return result.success === true;
+}
+
+async function start(request, env) {
+  if (request.headers.get('origin') !== env.DEMO_ORIGIN) return startPage(env, { status: 403, notice: 'Start the demo from this page.' });
+  const ip = request.headers.get('cf-connecting-ip') ?? '';
+  if (!(await env.STARTS.limit({ key: ip })).success) return startPage(env, { status: 429, notice: 'Too many demos started from your network. Try again in a minute.' });
+  const form = await request.formData();
+  if (!await human(env, form.get('cf-turnstile-response'), ip)) return startPage(env, { status: 403, notice: 'The check did not pass. Try again.' });
+  const id = env.DEMO.newUniqueId(), ends = Date.now() + HOUR;
+  if (!await env.CAPACITY.get(env.CAPACITY.idFromName('capacity')).acquire(id.toString(), ends, Number(env.DEMO_MAX_INSTANCES))) {
+    return startPage(env, { status: 503, notice: 'Every demo is in use right now. Try again in a few minutes.' });
+  }
+  const demo = env.DEMO.get(id);
+  try {
+    const signedIn = await demo.start({ origin: env.DEMO_ORIGIN, originVar: env.DEMO_ORIGIN_VAR, ends, endsLocal: localTime(ends, request.cf?.timezone), settings: JSON.parse(env.DEMO_SETTINGS) });
+    const headers = new Headers({ location: signedIn.location, 'cache-control': 'no-store' });
+    for (const cookie of [...signedIn.cookies, demoCookie(env, id.toString())]) headers.append('set-cookie', cookie);
+    return new Response(null, { status: 303, headers });
+  } catch (error) {
+    console.error('Demo start failed:', error.message);
+    await demo.end();
+    return startPage(env, { status: 502, notice: 'The demo did not start. Try again.' });
+  }
+}
+
+export default {
+  async fetch(request, env) {
+    const url = new URL(request.url);
+    if (url.pathname === '/__demo/start') return request.method === 'POST' ? start(request, env) : home();
+    const id = demoId(request, env);
+    if (id) return env.DEMO.get(id).fetch(request);
+    if (!['GET', 'HEAD'].includes(request.method)) return new Response('Start a demo first.', { status: 403 });
+    if (url.pathname !== '/') return home();
+    return startPage(env);
+  },
+};
