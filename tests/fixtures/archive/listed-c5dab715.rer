"name":"component_standing_claims","rowidAlias":null,"sql":"CREATE TABLE component_standing_claims (\n  id TEXT PRIMARY KEY NOT NULL,\n  component_id TEXT NOT NULL UNIQUE REFERENCES components(id) ON DELETE CASCADE,\n  state TEXT NOT NULL CHECK (state IN ('Operational', 'Degraded performance', 'Partially unavailable', 'Major outage', 'Under maintenance')),\n  operator_id TEXT NOT NULL REFERENCES operators(id) ON DELETE RESTRICT,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"component_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"history_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"state","notnull":1,"pk":0,"type":"TEXT"},{"name":"starts_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"ends_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"reason","notnull":1,"pk":0,"type":"TEXT"},{"name":"operator_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":0,"dependencies":["component_state_history","components","operators"],"name":"component_state_corrections","rowidAlias":null,"sql":"CREATE TABLE component_state_corrections (\n  id TEXT PRIMARY KEY NOT NULL,\n  component_id TEXT NOT NULL REFERENCES components(id) ON DELETE CASCADE,\n  history_id TEXT NOT NULL REFERENCES component_state_history(id) ON DELETE RESTRICT,\n  state TEXT NOT NULL CHECK (state IN ('Operational', 'Degraded performance', 'Partially unavailable', 'Major outage', 'Under maintenance')),\n  starts_at TEXT NOT NULL,\n  ends_at TEXT NOT NULL,\n  reason TEXT NOT NULL CHECK (length(trim(reason)) > 0),\n  operator_id TEXT NOT NULL REFERENCES operators(id) ON DELETE RESTRICT,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"component_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"previous_state","notnull":1,"pk":0,"type":"TEXT"},{"name":"new_state","notnull":1,"pk":0,"type":"TEXT"},{"name":"cause_type","notnull":1,"pk":0,"type":"TEXT"},{"name":"cause_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"operator_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"supersedes_history_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"changed_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"}],"count":5,"dependencies":["component_state_history","components","operators"],"name":"component_state_history","rowidAlias":null,"sql":"CREATE TABLE component_state_history (\n  id TEXT PRIMARY KEY NOT NULL,\n  component_id TEXT NOT NULL REFERENCES components(id) ON DELETE CASCADE,\n  previous_state TEXT NOT NULL CHECK (previous_state IN ('Operational', 'Degraded performance', 'Partially unavailable', 'Major outage', 'Under maintenance')),\n  new_state TEXT NOT NULL CHECK (new_state IN ('Operational', 'Degraded performance', 'Partially unavailable', 'Major outage', 'Under maintenance')),\n  cause_type TEXT NOT NULL CHECK (cause_type IN ('standing-claim', 'incident', 'maintenance', 'correction')),\n  cause_id TEXT,\n  operator_id TEXT REFERENCES operators(id) ON DELETE SET NULL,\n  supersedes_history_id TEXT REFERENCES component_state_history(id) ON DELETE SET NULL,\n  changed_at TEXT NOT NULL,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"group_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"name","notnull":1,"pk":0,"type":"TEXT"},{"name":"description","notnull":1,"pk":0,"type":"TEXT"},{"name":"internal","notnull":1,"pk":0,"type":"INTEGER"},{"name":"display_order","notnull":1,"pk":0,"type":"INTEGER"},{"name":"note","notnull":1,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"only_show_if_degraded","notnull":1,"pk":0,"type":"INTEGER"},{"name":"uptime_start_date","notnul