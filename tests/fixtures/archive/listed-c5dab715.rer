incident_id TEXT NOT NULL REFERENCES incidents(id) ON DELETE CASCADE,\n  incident_update_id TEXT REFERENCES incident_updates(id) ON DELETE CASCADE,\n  file_name TEXT NOT NULL,\n  content_type TEXT NOT NULL,\n  storage_key TEXT NOT NULL,\n  uploaded_by_operator_id TEXT NOT NULL REFERENCES operators(id) ON DELETE RESTRICT,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"incident_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"component_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"component_name","notnull":1,"pk":0,"type":"TEXT"},{"name":"state","notnull":1,"pk":0,"type":"TEXT"},{"name":"relationship","notnull":1,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"updated_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"published_at","notnull":0,"pk":0,"type":"TEXT"}],"count":1,"dependencies":["components","incidents"],"name":"incident_components","rowidAlias":null,"sql":"CREATE TABLE incident_components (\n  id TEXT PRIMARY KEY NOT NULL,\n  incident_id TEXT NOT NULL REFERENCES incidents(id) ON DELETE CASCADE,\n  component_id TEXT REFERENCES components(id) ON DELETE SET NULL,\n  component_name TEXT NOT NULL,\n  state TEXT NOT NULL CHECK (state IN ('Operational', 'Degraded performance', 'Partially unavailable', 'Major outage', 'Under maintenance')),\n  relationship TEXT NOT NULL DEFAULT 'Primary' CHECK (relationship IN ('Primary', 'Dependent')),\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL\n, published_at TEXT)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"incident_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"lifecycle","notnull":1,"pk":0,"type":"TEXT"},{"name":"affected_audience","notnull":1,"pk":0,"type":"TEXT"},{"name":"customer_impact","notnull":1,"pk":0,"type":"TEXT"},{"name":"what_still_works","notnull":1,"pk":0,"type":"TEXT"},{"name":"details","notnull":1,"pk":0,"type":"TEXT"},{"name":"next_update_at","notnull":0