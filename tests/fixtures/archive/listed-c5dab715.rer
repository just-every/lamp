ates(id) ON DELETE RESTRICT,\n  maintenance_id TEXT REFERENCES maintenance(id) ON DELETE RESTRICT,\n  channel TEXT NOT NULL CHECK (channel IN ('email', 'webhook')),\n  outcome TEXT NOT NULL CHECK (outcome IN ('queued', 'delivered', 'bounced', 'complained', 'suppressed', 'failed')),\n  queued_at TEXT NOT NULL,\n  outcome_at TEXT,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL, notification_event_id TEXT, notification_event_type TEXT, incident_report_id TEXT REFERENCES incident_reports(id) ON DELETE RESTRICT, mail_payload_json TEXT, dispatch_locked_at TEXT, incident_impact TEXT CHECK (incident_impact IN ('none', 'minor', 'major', 'critical')),\n  CHECK (incident_update_id IS NOT NULL OR maintenance_id IS NOT NULL)\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"delivery_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"attempt_number","notnull":1,"pk":0,"type":"INTEGER"},{"name":"attempted_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"provider_message_id","notnull":0,"pk":0,"type":"TEXT"},{"name":"error","notnull":0,"pk":0,"type":"TEXT"},{"name":"created_at","notnull":1,"pk":0,"type":"TEXT"},{"name":"local_capture_id","notnull":0,"pk":0,"type":"TEXT"}],"count":0,"dependencies":["notification_deliveries"],"name":"notification_delivery_attempts","rowidAlias":null,"sql":"CREATE TABLE notification_delivery_attempts (\n  id TEXT PRIMARY KEY NOT NULL,\n  delivery_id TEXT NOT NULL REFERENCES notification_deliveries(id) ON DELETE CASCADE,\n  attempt_number INTEGER NOT NULL,\n  attempted_at TEXT NOT NULL,\n  provider_message_id TEXT,\n  error TEXT,\n  created_at TEXT NOT NULL, local_capture_id TEXT\n  CHECK (local_capture_id IS NULL OR\n    (length(local_capture_id) > 0 AND provider_message_id IS NULL AND error IS NULL)),\n  UNIQUE(delivery_id, attempt_number)\n)"},{"columns":[{"name":"id","notnull":1,"pk":1,"type":"TEXT"},{"name":"kind","notnull":1,"pk":0,"type":"TEXT"},{"name":"aggregate_id","notnull":1,"pk":0,"type":"TEXT"},{"name":"payload_